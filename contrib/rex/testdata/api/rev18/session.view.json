{
  "input_schema": {
    "additionalProperties": false,
    "properties": {
      "session_id": {
        "description": "The session to act on.",
        "type": "string"
      }
    },
    "required": [
      "session_id"
    ],
    "type": "object"
  },
  "name": "session.view",
  "output_schema": {
    "additionalProperties": false,
    "properties": {
      "active_window_id": {
        "description": "The window the session shows. Left out when the session has no windows.",
        "type": [
          "string",
          "null"
        ]
      },
      "label": {
        "description": "The session's label.",
        "type": "string"
      },
      "revision": {
        "description": "The view's revision. A larger revision is a newer view of the session, even across a server restart. It goes up by one with each change, and jumps ahead when a restarted server restores the session.",
        "minimum": 0,
        "type": "integer"
      },
      "session_id": {
        "description": "The session's ID.",
        "type": [
          "string",
          "null"
        ]
      },
      "windows": {
        "description": "The session's windows, in order. Rex.app shows them as tabs in this order.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "focused_block_id": {
              "description": "The window's focused block, which receives typing while the window is active. Left out if the window has none.",
              "type": [
                "string",
                "null"
              ]
            },
            "label": {
              "description": "The window's label.",
              "type": "string"
            },
            "layers": {
              "description": "The window's layers, from back to front. The first is the tiled layer, which holds the window's layout and fills the window.",
              "items": {
                "additionalProperties": false,
                "properties": {
                  "blocks": {
                    "description": "The blocks in the layer, in layout order. The layout field says where each one sits.",
                    "items": {
                      "additionalProperties": false,
                      "properties": {
                        "block_id": {
                          "description": "The block's ID.",
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "creator_name": {
                          "description": "The creator that made the block, such as com.superlogical.terminal.",
                          "type": "string"
                        },
                        "flavor": {
                          "description": "The flavor the block was made from, such as com.superlogical.terminal.shell.",
                          "type": "string"
                        },
                        "host_id": {
                          "description": "Identifies the machine and account the block runs as. If it equals your local server's host_id, the block sees the same files you do. Otherwise treat the block as remote.",
                          "type": "string"
                        },
                        "label": {
                          "description": "The block's label.",
                          "type": "string"
                        },
                        "owner": {
                          "description": "The client that owns the block. Left out when the block has no owner.",
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "block_id"
                      ],
                      "type": "object"
                    },
                    "type": [
                      "null",
                      "array"
                    ]
                  },
                  "bounds": {
                    "description": "Where the layer sits, as [x, y, w, h] fractions of the window's width and height.",
                    "items": {
                      "type": "number"
                    },
                    "maxItems": 4,
                    "minItems": 4,
                    "type": "array"
                  },
                  "kind": {
                    "description": "How the layer is placed: 'tiled' for the layer that fills the window, or 'floating' for a floating layer. Draw a kind you don't know as 'floating'.",
                    "type": "string"
                  },
                  "layer_id": {
                    "description": "The layer's ID.",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "layout": {
                    "$anchor": "view-layout-node",
                    "description": "How the layer divides its space between blocks, as a tree of splits. Null when the layer is empty.",
                    "properties": {
                      "block_id": {
                        "description": "The block at this node. Set only when split isn't.",
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "rect": {
                        "description": "Where this node sits, as [x, y, w, h] fractions of the window's width and height.",
                        "items": {
                          "type": "number"
                        },
                        "maxItems": 4,
                        "minItems": 4,
                        "type": "array"
                      },
                      "split": {
                        "description": "How this node divides in two. Set only when block_id isn't.",
                        "properties": {
                          "after": {
                            "$ref": "#view-layout-node",
                            "description": "The node on the right or bottom."
                          },
                          "before": {
                            "$ref": "#view-layout-node",
                            "description": "The node on the left or top."
                          },
                          "direction": {
                            "description": "How the space is divided: 'horizontal' puts before on the left and after on the right, and 'vertical' puts before above after. Draw a direction you don't know as 'horizontal'.",
                            "enum": [
                              "horizontal",
                              "vertical"
                            ],
                            "type": "string"
                          },
                          "ratio": {
                            "description": "The fraction of the space that before gets, between 0 and 1.",
                            "type": "number"
                          },
                          "split_id": {
                            "description": "The split's ID. It stays the same while the split exists, so you can match splits across views.",
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "split_id",
                          "direction",
                          "ratio",
                          "before",
                          "after"
                        ],
                        "type": [
                          "object",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "rect"
                    ],
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "state": {
                    "description": "How the layer is presented: 'minimized' means don't draw it, though its blocks keep running, and only a floating layer can be minimized. Left out for a normal layer. Draw a state you don't know as normal.",
                    "type": "string"
                  }
                },
                "required": [
                  "layer_id",
                  "kind",
                  "bounds",
                  "layout",
                  "blocks"
                ],
                "type": "object"
              },
              "type": [
                "null",
                "array"
              ]
            },
            "window_id": {
              "description": "The window's ID.",
              "type": [
                "string",
                "null"
              ]
            },
            "zoomed_block_id": {
              "description": "The block zoomed to fill the window, if any. Layouts keep their normal sizes, so draw this block over the whole window.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "window_id",
            "layers"
          ],
          "type": "object"
        },
        "type": [
          "null",
          "array"
        ]
      }
    },
    "required": [
      "revision",
      "session_id"
    ],
    "type": "object"
  }
}
