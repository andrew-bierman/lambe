<?xml version="1.0" encoding="UTF-8"?>
<!-- lambe supervisor daemon — launchd user agent example.
     `lambe service install` generates this with your real paths.
     KeepAlive restarts the daemon whenever it exits for any reason other
     than an unload; the flock state lock makes a doubled start harmless. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lambe.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/lambe</string>
        <string>run</string>
        <string>-config</string>
        <string>/Users/you/Library/Application Support/lambe/config.yaml</string>
    </array>

    <!-- Always keep the supervisor alive: crash, clean exit, reboot. -->
    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <!-- SIGTERM runs the bounded kill ladder against supervised agents,
         then the daemon exits 0. -->
    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/Users/you/Library/Logs/lambe/daemon.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/you/Library/Logs/lambe/daemon.log</string>

    <!-- launchd starts jobs with a minimal PATH; bd and the agent must be reachable. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/you/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <!-- Room for the daemon's SIGTERM -> grace -> SIGKILL ladder (default is 20s). -->
    <key>ExitTimeOut</key>
    <integer>45</integer>
</dict>
</plist>
