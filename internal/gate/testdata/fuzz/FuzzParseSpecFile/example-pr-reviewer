[]byte("# Formula: pr-reviewer (a human-gated responsibility)\x0a#\x0a# Responsibility: every open pull request gets reviewed \xe2\x80\x94 first by the\x0a# agent (summary, risk callouts, review comments), then by a human, whose\x0a# approval is the only path to done.\x0a#\x0a# Trigger: fires (non-zero exit) when at least one open PR is awaiting\x0a# review, so each such PR materializes one review issue.\x0a#\x0a# Gate: lambe has no native \"human\" gate kind \xe2\x80\x94 the parser accepts only\x0a# type shell, gh:run, or gh:pr (see internal/gate/gate.go ParseKind). The\x0a# human exit-gate is therefore modeled as a shell gate that polls the PR's\x0a# review decision: the gate stays red until a human approves on GitHub,\x0a# and the loop's retry/escalation machinery (attempt caps, needs-human)\x0a# handles the waiting. Swap in your own approval signal (a label, a\x0a# comment convention, a file) if GitHub reviews are not your flow.\x0a#\x0a# Schema (bd-native, validated by \x60bd cook <file> --dry-run\x60): the root\x0a# \x60formula\x60 field is the name (convention mol-<name>); steps are a\x0a# [[steps]] slice with id/title/run. See internal/formula/types.go in bd.\x0a\x0aformula = \"pr-reviewer\"\x0atitle = \"Review every open pull request\"\x0a\x0a[trigger]\x0a# Fires when any PR is sitting in review-pending state.\x0acommand = 'test -n \"$(gh pr list --repo \"${LAMBE_GH_REPO:-.}\" --review-pending --state open --json number --jq \".[].number\")\"'\x0a\x0a[[steps]]\x0aid = \"summarize\"\x0atitle = \"Summarize the diff for the reviewer\"\x0arun = 'gh pr diff \"${LAMBE_PR_NUMBER:?}\" > /tmp/pr.diff && review-summarize /tmp/pr.diff | gh pr comment \"${LAMBE_PR_NUMBER}\" --body-file -'\x0a\x0a[[steps]]\x0aid = \"request_review\"\x0atitle = \"Request human review\"\x0arun = 'gh pr ready \"${LAMBE_PR_NUMBER:?}\" && gh pr edit \"${LAMBE_PR_NUMBER:?}\" --add-reviewer \"${LAMBE_REVIEWER:?}\"'\x0a\x0a[gate]\x0a# Human exit-gate, shell-shaped: green only when a human has APPROVED the\x0a# PR on GitHub. Every non-approved state (PENDING, CHANGES_REQUESTED, no\x0a# review) is red, and the gate output tells the agent what is still being\x0a# asked of the human.\x0atype = \"shell\"\x0acommand = 'test \"$(gh pr view \"${LAMBE_PR_NUMBER:?}\" --json reviewDecision --jq .reviewDecision)\" = \"APPROVED\"'\x0a")
