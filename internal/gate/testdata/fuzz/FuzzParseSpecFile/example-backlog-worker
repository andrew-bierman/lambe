[]byte("# Formula: backlog-worker (the finite-work pattern)\x0a#\x0a# Responsibility: burn down the ready backlog one issue at a time. This\x0a# formula has NO trigger \xe2\x80\x94 it is never auto-fired by a CI signal. The work\x0a# is finite and pre-existing (issues already carry the label below); you\x0a# pour it manually when you want a worker session:\x0a#\x0a#     bd cook backlog-worker\x0a#     bd mol pour --dry-run   # rehearse first, then drop --dry-run\x0a#\x0a# Once poured, the issues enter the same two-read dispatch as any other\x0a# work: the loop claims the next ready issue whose label matches, runs an\x0a# attempt, and gates it.\x0a#\x0a# Parsed anatomy: lambe reads [trigger].command (required by LoadFormulas)\x0a# and the [gate] table. The steps/label keys below are for bd cook/pour.\x0a\x0a[trigger]\x0a# Manual pour pattern: a trigger that never fires on its own. \x60exit 0\x60\x0a# always means \"not fired\", so the loop only ever materializes this\x0a# formula when a human runs bd cook + bd mol pour by hand.\x0acommand = \"exit 0\"\x0a\x0a[steps]\x0a# Claim the next ready issue carrying the worker label. Exactly one issue\x0a# per pour keeps the batch finite and reviewable.\x0a[[steps.claim]]\x0arun = 'bd ready --label \"${LAMBE_WORKER_LABEL:-lambe-worker}\" --limit 1'\x0a\x0a[gate]\x0a# Verified completion: the workspace must pass the full local verification\x0a# suite. The command runs with the workspace as cwd; non-zero exit is a\x0a# red verdict and the failure output goes back to the agent as guidance.\x0atype = \"shell\"\x0acommand = \"mise exec go -- go test ./... && mise exec go -- go build ./... && test -z \x5c\"$(go run mvdan.cc/gofumpt -l .)\x5c\" && go run honnef.co/go/tools/cmd/staticcheck ./...\"\x0a")
