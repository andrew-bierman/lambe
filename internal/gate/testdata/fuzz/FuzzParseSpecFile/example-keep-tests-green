go test fuzz v1
[]byte("# Formula: keep-tests-green (the flagship responsibility)\x0a#\x0a# Responsibility: the main branch's CI must always be green. When it is not,\x0a# this formula materializes an issue so an agent diagnoses the failure and\x0a# lands a fix on a pull request. Done means CI on the PR head is green \xe2\x80\x94\x0a# never the agent's local test output.\x0a#\x0a# Anatomy (what lambe actually parses):\x0a#   [trigger] command \xe2\x80\x94 run under \x60sh -lc\x60 with the formula's directory as\x0a#     cwd; a NON-ZERO exit means the trigger fired. Exit 0 = all quiet.\x0a#   [gate] type/pr \xe2\x80\x94 the verified-completion gate judged on a settled turn.\x0a#     type \"gh:pr\" requires \x60pr\x60 (a pull-request number, url, or branch);\x0a#     the CI status of the PR head is what counts.\x0a#\x0a# Parameterize per repo by exporting LAMBE_GH_REPO (default: this repo's\x0a# origin) and LAMBE_CI_BRANCH (default: main). The trigger is a single\x0a# quoted shell command; $VAR expansion happens in the shell, not TOML.\x0a#\x0a# Steps below are consumed by \x60bd cook\x60 when the trigger materializes the\x0a# issue; lambe's own parsers read only [trigger] and [gate].\x0a\x0a[trigger]\x0a# Fires when the latest CI run on the watched branch is anything other than\x0a# \"success\" (failure, cancelled, or no runs at all \xe2\x80\x94 jq yields null, which\x0a# fails the string compare and fires).\x0acommand = 'test \"$(gh run list --repo \"${LAMBE_GH_REPO:-.}\" --branch \"${LAMBE_CI_BRANCH:-main}\" --limit 1 --json conclusion --jq \".[0].conclusion\")\" = \"success\"'\x0a\x0a[steps]\x0a# Step 1: diagnose. Read the failing run's logs and identify the root cause.\x0a[[steps.diagnose]]\x0arun = 'gh run list --repo \"${LAMBE_GH_REPO:-.}\" --branch \"${LAMBE_CI_BRANCH:-main}\" --limit 1 --status failure --json databaseId --jq \".[0].databaseId\"'\x0a\x0a# Step 2: fix. Branch off the failing commit, land the minimal fix, open a\x0a# PR back to the watched branch. The gate below is what proves it worked.\x0a[[steps.fix]]\x0arun = \"git checkout -b fix/ci-${LAMBE_CI_BRANCH:-main}-$$ && commit-fix && gh pr create --fill\"\x0a\x0a[gate]\x0a# Verified completion: the GitHub Actions checks on the PR head must\x0a# conclude successfully. Judging CI on the pushed head \xe2\x80\x94 not on the agent's\x0a# word or its local test run \xe2\x80\x94 is what prevents same-commit gaming: the\x0a# check runs on GitHub's machines against the exact merge candidate.\x0a#\x0a# NOTE: unlike the trigger (which runs under sh -lc and so expands $VAR),\x0a# the gate pr is passed verbatim to \x60gh pr view\x60. Use a literal branch\x0a# name here \xe2\x80\x94 no environment parameterization. This default points at the\x0a# repo's working branch; set it to the branch (or number/url) of the PR\x0a# the fix attempt actually opens.\x0atype = \"gh:pr\"\x0apr = \"feat/lambe-slice-one\"\x0a")
